{
  "name": "siyuan-plugin-omnikit",
  "version": "0.2.0",
  "description": "Modular personal tools for SiYuan built with TypeScript, Vite and Svelte 5",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm render:icons && cross-env NODE_ENV=development vite build --watch",
    "check": "tsc --noEmit -p tsconfig.omnikit.json && svelte-check --tsconfig ./tsconfig.omnikit.json",
    "check:types": "tsc --noEmit -p tsconfig.omnikit.json",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.omnikit.json",
    "test": "node --experimental-transform-types --test tests/omnikit-*.test.mjs",
    "build": "pnpm check && pnpm test && pnpm build:app",
    "build:app": "pnpm render:icons && cross-env NODE_ENV=production vite build",
    "build:fast": "pnpm build:app",
    "render:icons": "node tools/render-icons.mjs",
    "install:workspace": "pnpm build && node tools/install-workspace.mjs",
    "package:verify": "node scripts/verify-package.mjs"
  },
  "keywords": [],
  "author": "Forgo7ten",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.4.0",
    "cross-env": "^10.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "sass": "^1.103.1",
    "siyuan": "1.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-zip-pack": "^1.2.4"
  },
  "repository": "https://github.com/Forgo7ten/siyuan-plugin-omnikit",
  "type": "module",
  "dependencies": {
    "browser-image-compression": "2.0.2"
  }
}
